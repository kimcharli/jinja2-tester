{% macro route_filter_list(name, prefixes) %}
    route-filter-list {{ name }} {
{% for i_filter in prefixes %}
        {{ i_filter }};
{% endfor %}
    }
{% endmacro %}


{% set gw_local = interconnect.gateways.local | selectattr('name', 'eq', this_leaf.name )|first %}
