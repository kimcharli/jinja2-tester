policy-options {
{% for i_vrf in interconnect.vrf %}{# router_filter #}
{% set VRF_NAME = i_vrf.name %}
{{ route_filter_list('EVPN_DCI_L3_IN-' ~ VRF_NAME, i_vrf.in_route_filter) }}
{{ route_filter_list('EVPN_DCI_L3_OUT-' ~ VRF_NAME, i_vrf.out_route_filter) }}
{% endfor %}{# router_filter #}

    policy-statement EVPN_GW_IN {
        term EVPN_GW_IN-10 {
            from {
                family evpn;
                community EVPN_DCI_L2_TARGET;
            }
            then {
                accept;
            }
        }
{% set vars = namespace(TERM_NUMBER = 20) %}
{% for i_vrf in interconnect.vrf %}
        term EVPN_GW_IN-{{ vars.TERM_NUMBER }} {
            from {
                family evpn;
                community EVPN_DCI_L3_TARGET_{{ i_vrf.name }};
                route-filter-list EVPN_DCI_L3_IN-{{ i_vrf.name }};
            }
            then {
                accept;
            }
        }
{% set vars.TERM_NUMBER = vars.TERM_NUMBER + 10 %}
{% endfor %}
        term EVPN_GW_IN-{{ vars.TERM_NUMBER }} {
            from family evpn;
            then reject;
        }
    }
    policy-statement EVPN_GW_OUT {
        term EVPN_GW_OUT-20 {
            from {
                family evpn;
                community EVPN_DCI_L2_TARGET;
            }
            then {
                accept;
            }
        }
{% set vars = namespace(TERM_NUMBER = 20) %}
{% for i_vrf in interconnect.vrf %}
        term EVPN_GW_OUT-{{ vars.TERM_NUMBER }} {
            from {
                family evpn;
                community EVPN_DCI_L3_TARGET_{{ i_vrf.name }};
                route-filter-list EVPN_DCI_L3_OUT-{{ i_vrf.name }};
            }
            then {
                accept;
            }
        }
{% set vars.TERM_NUMBER = vars.TERM_NUMBER + 10 %}
{% endfor %}
        term EVPN_GW_IN-{{ vars.TERM_NUMBER }} {
            from family evpn;           
            then reject;                
        }                               
    }   
    policy-statement LEAF_TO_SPINE_EVPN_OUT {
#        term LEAF_TO_SPINE_EVPN_OUT-10 {
#            from {
#                protocol bgp;
#                community FROM_SPINE_EVPN_TIER;
#            }
#            then reject;
#        }
#        term LEAF_TO_SPINE_EVPN_OUT-20 {
#            from {
#                protocol [ bgp evpn ];
#                community FABRIC_EVI_TARGET;
#            }
#            then accept;
#        }
        term LEAF_TO_SPINE_EVPN_OUT-30 {
            from {
                protocol [ bgp evpn ];
{% set i_vrf_communities = [] %}
{% for i_vrf in interconnect.vrf %}
{% set _ = i_vrf_communities.append('EVPN_DCI_L3_TARGET_' ~ i_vrf.name) %}
{% endfor %}
                community [ EVPN_DCI_L2_TARGET {{ i_vrf_communities | join(' ') }} ];
            }
            then reject;
        }                               
#        term LEAF_TO_SPINE_EVPN_OUT-40 {
#            then accept;                
#        }                               
    }      
    community EVPN_DCI_L2_TARGET members target:{{ interconnect.i_RT }};
{% for i_vrf in interconnect.vrf %}
    community EVPN_DCI_L3_TARGET_{{ i_vrf.name }} members target:{{ i_vrf.i_RT }};
{% endfor %}
}
{% endif %}{# gw_local #}
