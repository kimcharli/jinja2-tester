{#
---
name: analyzer
summary: Mirror tagged interfaces to a collector using an analyzer
config_style: junos
section: top_level_hierarchical
roles: [all]
category: optional
status: active
requires:
  vars: [interface]
  tags: [mirror]
---
Mirror the interface using an analyzer, selecting interfaces by the intf_tags
value 'mirror'. The collector address and the tag literal are defined at the
top of the template in place of property sets.
-#}
{% set collector_ip = '192.168.0.2' %}
{% set mirror_tag = 'mirror' %}
{# build variables for the script #}
{% set mirrored_interfaces = [] %}
{% for intf in interface.values() %}
{% if 'tags' in intf and mirror_tag in intf['tags'] %}
{% if intf['part_of'] == '' %}
{% set mirrored_interfaces = mirrored_interfaces.append(intf['intfName']) %}
{% else %}
{% set mirrored_interfaces = mirrored_interfaces.append(intf['part_of']) %}
{% endif %}
{% endif %}
{% endfor %}
{# scripts starts here #}
{% if mirrored_interfaces|length %}
forwarding-options {
    analyzer {
        mirro1 {
            input {
                ingress {
{% for intf in mirrored_interfaces %}
                    interface {{ intf }}.0;
{% endfor %}
                }
                egress {
{% for intf in mirrored_interfaces %}
                    interface {{ intf }}.0;
{% endfor %}
                }
            }
            output {
                ip-address {{ collector_ip }};
            }
        }
    }    
}
{% endif %}
