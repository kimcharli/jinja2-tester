{#
---
name: ospf-tags
summary: Tag based OSPF for routing zones and IRB interfaces
config_style: junos
section: top_level_set_delete
roles: [leaf]
category: misc
status: active
requires:
  vars: [system_tags, security_zones, vxlan, vlan]
  tags: [ospf, ospf/passive]
author: kimcharli@gmail.com
updated: 2026-10-20
---
Tag based OSPF configlet.

OSPF configured when:
  - system_tags has 'ospf'
  - vxlan.<n>.tags has 'ospf' (active) or 'ospf/passive'
  - vlan.<n> has ipv4_address or fhrp_ipv4_address (anycast IRB)
-#}
{% set SYSTEM_OSPF_TAG = 'ospf' %}
{% set OSPF_ACTIVE_TAG = 'ospf' %}
{% set OSPF_PASSIVE_TAG = 'ospf/passive' %}
{% set OSPF_AREA = '0.0.0.0' %}
{% set OSPF_MTU = 1500 %}
{% set ORIGIN_OSPF_COMMUNITY = '65000:5555' %}
{% set ORIGIN_FABRIC_TAG = 5555 %}
{% set FABRIC_TO_OSPF_PREFIX = '0.0.0.0/0' %}

{%- if SYSTEM_OSPF_TAG in system_tags %}{# SYSTEM_TAGS #}
{# 1. Global Policy & Community #}
set policy-options community ORIGIN-OSPF members {{ ORIGIN_OSPF_COMMUNITY }}
set policy-options policy-statement VRF-OSPF-TO-EVPN term BLOCK-FABRIC-REINJECT from protocol ospf
set policy-options policy-statement VRF-OSPF-TO-EVPN term BLOCK-FABRIC-REINJECT from tag {{ ORIGIN_FABRIC_TAG }}
set policy-options policy-statement VRF-OSPF-TO-EVPN term BLOCK-FABRIC-REINJECT then reject
set policy-options policy-statement VRF-OSPF-TO-EVPN term MARK-OSPF from protocol ospf
set policy-options policy-statement VRF-OSPF-TO-EVPN term MARK-OSPF then community add ORIGIN-OSPF
set policy-options policy-statement VRF-OSPF-TO-EVPN term MARK-OSPF then accept
set policy-options policy-statement VRF-TO-OSPF term BLOCK-OSPF-REINJECT from protocol [ bgp evpn ]
set policy-options policy-statement VRF-TO-OSPF term BLOCK-OSPF-REINJECT from community ORIGIN-OSPF
set policy-options policy-statement VRF-TO-OSPF term BLOCK-OSPF-REINJECT then reject
set policy-options policy-statement VRF-TO-OSPF term MARK-FABRIC from protocol [ bgp evpn ]
set policy-options policy-statement VRF-TO-OSPF term MARK-FABRIC from route-filter {{ FABRIC_TO_OSPF_PREFIX }} orlonger
set policy-options policy-statement VRF-TO-OSPF term MARK-FABRIC then tag {{ ORIGIN_FABRIC_TAG }}
set policy-options policy-statement VRF-TO-OSPF term MARK-FABRIC then external type 1
set policy-options policy-statement VRF-TO-OSPF term MARK-FABRIC then metric 100
set policy-options policy-statement VRF-TO-OSPF term MARK-FABRIC then accept
{# 2. Per-Routing-Zone OSPF & IRB Config #}
{% for sz_name, sz_value in security_zones.items() %}{# RZ_LOOP #}
{% set ospf_vxlans = namespace(dict={}) %}
{% for vn in vxlan.values() %}{# VXLAN_DICT #}
{# Require IRB IPv4 (or anycast FHRP IPv4) on the bound VLAN so loop.first stays accurate #}
{% if vn.vrf_name == sz_name and vn.tags and (OSPF_ACTIVE_TAG in vn.tags or OSPF_PASSIVE_TAG in vn.tags) and (vlan[vn.vlan_id | string].ipv4_address or vlan[vn.vlan_id | string].fhrp_ipv4_address) %}
{% if ospf_vxlans.dict.update({vn.vlan_id | string: vn.tags}) %}{% endif %}
{% endif %}
{% endfor %}{# VXLAN_DICT #}
{% for vlan_id, vlan_tags in ospf_vxlans.dict.items() %}{# OSPF_VLANS #}
{% if loop.first %}{# SZ_FIRST #}
set routing-instances {{ sz_name }} routing-options router-id {{ sz_value['loopback_ip'] }}
set routing-instances {{ sz_name }} protocols ospf area {{ OSPF_AREA }} interface {{ sz_value['loopback_intf'] }} passive
set routing-instances {{ sz_name }} protocols ospf export VRF-TO-OSPF
delete routing-instances {{ sz_name }} protocols evpn ip-prefix-routes export BGP-AOS-Policy-{{ sz_name }}
set routing-instances {{ sz_name }} protocols evpn ip-prefix-routes export VRF-OSPF-TO-EVPN
set routing-instances {{ sz_name }} protocols evpn ip-prefix-routes export BGP-AOS-Policy-{{ sz_name }}
{% endif %}{# SZ_FIRST #}
{# Check 'ospf/passive' first so a VN tagged with both renders passive #}
{% if OSPF_PASSIVE_TAG in vlan_tags %}
set routing-instances {{ sz_name }} protocols ospf area {{ OSPF_AREA }} interface irb.{{ vlan_id }} passive
{% else %}
set routing-instances {{ sz_name }} protocols ospf area {{ OSPF_AREA }} interface irb.{{ vlan_id }} mtu {{ OSPF_MTU }}
{% endif %}
{% endfor %}{# OSPF_VLANS #}
{% endfor %}{# RZ_LOOP #}
{% endif %}{# SYSTEM_TAGS #}
